# Application Environment
APP_ENV=development

# Discord Bot Tokens
DEV_DISCORD_BOT_TOKEN=your_dev_bot_token_here
PROD_DISCORD_BOT_TOKEN=your_prod_bot_token_here

# Bot API Port
BOT_API_PORT=8090
BOT_API_URL=http://localhost:8090

# Web API Port
PORT=8080

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Discord OAuth
DISCORD_CLIENT_ID=deine_client_id_hier
DISCORD_CLIENT_SECRET=dein_client_secret_hier
DISCORD_REDIRECT_URL=http://localhost:8080/api/auth/discord/callback

# Guild und Role IDs
GUILD_ID=your_guild_id_here
DISCORD_TRACKED_ROLE_ID=optional_role_id_to_track
MODERATOR_ROLE_IDS=mod_roles
ADMIN_ROLE_IDS=admin_roles

# JWT Secret
JWT_SECRET=ein_sicheres_random_secret_hier

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=discord_bot
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
